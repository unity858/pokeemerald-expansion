ShoalCave_LowTideIceRoom_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, ShoalCave_LowTideIceRoom_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, ShoalCave_LowTideIceRoom_OnResume
	.byte 0

ShoalCave_LowTideIceRoom_OnTransition:
	call ShoalCave_LowTideIceRoom_EventScript_SetupKyurem
	end

ShoalCave_LowTideIceRoom_OnResume:
	call_if_set FLAG_SYS_CTRL_OBJ_DELETE, HackStatic_EventScript_TryRemoveCaughtMon
	end

ShoalCave_LowTideIceRoom_EventScript_SetupKyurem::
	setupstaticenc STATIC_ENC_KYUREM, FLAG_TEMP_HIDE_STATIC_MON
	return

ShoalCave_LowTideIceRoom_EventScript_Kyurem::
	staticencounter STATIC_ENC_KYUREM, SPECIES_KYUREM
